<?xml version="1.0" encoding="utf-8"?>
<!-- InCallService de Mina (SPEC-MINA-COMMS-001 §8, Phase 5). Ce manifest de module n'est fusionné
     dans l'app QUE si l'app dépend de :feature:telephony — ce qui n'est pas encore le cas : le module
     est isolé, rien ne s'active. L'obtention du rôle téléphone/dialer par défaut est une étape
     on-device séparée (activation), pas déclenchée par cette déclaration. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <application>
        <service
            android:name="fr.mina.gateway.telephony.MinaInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
