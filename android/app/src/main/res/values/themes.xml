<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème de l'écran Compose : sans barre système opaque, les couleurs viennent du thème
      Compose (MinaChatTheme) et suivent le mode jour/nuit du système.
    -->
    <style name="Theme.MinaChat" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
