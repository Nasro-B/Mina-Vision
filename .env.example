# ==============================================================================
#  Mina Vision — modèle de configuration (.env)
# ==============================================================================
#  Copiez ce fichier en `.env` et remplissez ce dont vous avez besoin.
#  TOUT est OPTIONNEL : Mina démarre sans aucune clé (voix + missions locales).
#  Chaque bloc active une capacité en plus. Rien ici n'est committé (`.env`
#  gitignoré). Ne mettez jamais de vraie clé dans `.env.example`.
#
#  Astuce Vercel/CI : n'introduisez jamais de `\n`/`\r` en collant une valeur.
# ==============================================================================

# --- IA conversationnelle (au moins une clé recommandée) ----------------------
# Chaîne de repli : la première disponible répond, sinon on passe à la suivante.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=

# --- Hugging Face (texte/inférence hébergée, filet de la chaîne de repli) ------
HF_TOKEN=
HUGGINGFACE_TOKEN=
HF_INFERENCE_BASE_URL=
HF_TEXT_MODEL=

# --- Modal (endpoint d'inférence privé, optionnel) ----------------------------
MODAL_ENDPOINT=
MODAL_MODEL=
MODAL_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# --- Voix (transcription temps réel, optionnel) -------------------------------
DEEPGRAM_API_KEY=

# --- LM Studio (modèles LOCAUX : texte, vision, embeddings) --------------------
LM_STUDIO_ENABLED=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_TEXT_MODEL=
LM_STUDIO_VISION_MODEL=
LM_STUDIO_EMBEDDING_MODEL=
LM_STUDIO_TIMEOUT_MS=120000

# --- Mode d'inférence global --------------------------------------------------
# auto | local-first | cloud-first. MINA_OFFLINE=true coupe tout appel réseau IA.
MINA_INFERENCE_MODE=auto
MINA_OFFLINE=false

# --- Garde-fous des missions --------------------------------------------------
MINA_MAX_ACTIONS=40
MINA_TIMEOUT_MS=900000
MINA_DRY_RUN=true
MINA_KEYS_ROTATED=false

# --- Outils Android (chemins ; vides = binaires du PATH) ----------------------
ADB_PATH=
SCRCPY_PATH=
# Serial d'un 2e téléphone à garder en Wi-Fi (reconnexion auto vérifiée).
MINA_SAMSUNG_ADB_SERIAL=
# Appareils du réseau à NE JAMAIS toucher en ADB, par OUI MAC (3 octets, séparés
# par « , » ou « ; »). La télé Condor (09:8d:05) est déjà exclue par défaut.
MINA_ADB_EXCLUDE_OUI=

# --- Canal « application Mina » (téléphone appairé ↔ PC) ----------------------
# Port/hôte du serveur local du chat chiffré. Ouvrez le port au pare-feu privé.
MINA_CHAT_PORT=8771
MINA_CHAT_HOST=0.0.0.0
# Chemin du google-services.json (relais Firebase quand le direct ne passe pas).
# Défaut : env/google-services.json. Sans lui, le canal reste 100 % local.
MINA_GOOGLE_SERVICES=

# --- Sauvegarde chiffrée Firebase (optionnel) ---------------------------------
# Les DEUX requis pour activer la sauvegarde cloud chiffrée de la mémoire.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- YouTube Data API v3 ------------------------------------------------------
# Clé API SIMPLE (Google Cloud Console → Identifiants → Créer une clé API).
# Activer l'API ne suffit pas ; un compte de service NE marche PAS pour la recherche.
YOUTUBE_API_KEY=

# --- Telegram -----------------------------------------------------------------
# ID numérique du propriétaire (via @userinfobot), pour autoriser /home et /mail.
TELEGRAM_OWNER_CHAT_ID=

# --- SMS : garde-fous d'envoi (natif ET httpSMS) ------------------------------
# manual = chaque envoi confirmé localement ; allowlist = seuls les numéros listés.
SMS_SEND_MODE=manual
# Numéros E.164 autorisés, séparés par des virgules (ex. +2135…,+2136…).
SMS_ALLOWLIST=
SMS_MAX_PER_DAY=20
SMS_MAX_PER_MINUTE=2
# Heures calmes (0–23) : aucun SMS envoyé dans cette plage. Vides = désactivé.
SMS_QUIET_HOURS_START=
SMS_QUIET_HOURS_END=

# --- httpSMS : passerelle SMS quand le téléphone natif est hors-ligne ---------
# Guide complet d'installation : docs/guides/httpsms.md
# Les 4 premières requises pour ACTIVER ; sinon Mina utilise le SMS natif seul.
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=
HTTPSMS_WEBHOOK_SECRET=
HTTPSMS_FROM_NUMBER=
# native-first | httpsms-first | native-only | httpsms-only
HTTPSMS_SMS_MODE=native-first
# Port local du serveur qui reçoit les SMS entrants (webhook, loopback).
HTTPSMS_WEBHOOK_PORT=8787

# --- Emplacements de stockage (portabilité ; vides = sous userData) -----------
# À ne remplir que pour déplacer caches/modèles/bac à sable hors du profil.
MINA_CACHE_ROOT=
MINA_MODELS_ROOT=
MINA_SANDBOX_ROOT=
MINA_SANDBOX_RUNTIME_ROOT=
# Racines d'écriture de confiance et de lecture approuvée, séparées par « ; ».
MINA_TRUSTED_WRITE_ROOTS=
MINA_APPROVED_READ_ROOTS=
