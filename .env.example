# YouTube Data API v3 — clé API SIMPLE (Google Cloud Console → Identifiants → Créer une clé API).
# Activer l'API ne suffit pas : il faut cette clé. Un service account NE marche PAS pour la recherche.
YOUTUBE_API_KEY=

# Telegram — ID numérique du propriétaire (via @userinfobot), pour autoriser /home et /mail.
TELEGRAM_OWNER_CHAT_ID=

# HTTPSMS (fallback SMS quand le Huawei est hors-ligne). Les 4 requis pour activer ; sinon SMS natif seul.
HTTPSMS_BASE_URL=
HTTPSMS_API_KEY=
HTTPSMS_WEBHOOK_SECRET=
HTTPSMS_FROM_NUMBER=
HTTPSMS_SMS_MODE=native-first
HTTPSMS_WEBHOOK_PORT=8787
