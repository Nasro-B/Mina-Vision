rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /owners/{ownerId}/devices/{deviceId}/{objectPath=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == ownerId;
    }

    match /{objectPath=**} {
      allow read, write: if false;
    }
  }
}
